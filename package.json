{
  "name": "tokenizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest --run",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:e2e": "playwright test",
    "test:visual": "node scripts/visual-validation.mjs",
    "typecheck": "tsc -b --pretty false",
    "design:lint": "designmd lint DESIGN.md",
    "design:fixtures": "node scripts/generate-design-fixture.mjs",
    "design:visual-diff": "node scripts/visual-diff-target.mjs"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@google/design.md": "0.2.0",
    "@playwright/test": "1.60.0",
    "@types/node": "25.9.1",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "4.1.12"
  }
}
